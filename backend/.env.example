# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/hicaptain
MONGODB_DATABASE=hicaptain
# Docker only: separate root and database-scoped application passwords (use URL-safe random hex).
MONGO_USERNAME=admin
MONGO_PASSWORD=
MONGO_APP_USERNAME=hicaptain
MONGO_APP_PASSWORD=

# Security - JWT
JWT_SECRET=your-jwt-secret-key-here-minimum-256-bits

# One GitHub OAuth App for sign-in and repository access
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
# Generate with openssl rand -base64 32; keep stable. Google token key is used if omitted.
PROVIDER_TOKEN_ENCRYPTION_KEY=
# Optional override; normally derived from BACKEND_URL:
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
GITHUB_OAUTH_SCOPES=repo,read:user,user:email,admin:repo_hook
# Optional webhooks: generate openssl rand -hex 32 and set the same secret in GitHub.
GITHUB_WEBHOOK_SECRET=

# Google sign-in and Workspace (Calendar, Meet, project folders, Tasks)
# OAuth Web application credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional overrides; normally derived from BACKEND_URL:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/google-calendar/auth/callback
# GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback
# Generate with: openssl rand -base64 32. Keep this key stable to retain existing connections.
GOOGLE_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Server Configuration
SERVER_PORT=8080
# Public backend origin, without a trailing slash. OAuth redirects default to this origin.
BACKEND_URL=http://localhost:8080

# Organization invitation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=invites@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:3000

# Optional AI teammates: same random secret in backend and worker (openssl rand -hex 32).
AGENT_WORKER_SECRET=
# Only exact HTTP(S) origins from this list can be used for Ollama.
AGENT_OLLAMA_ALLOWED_ORIGINS=http://localhost:11434,http://ollama:11434,http://host.docker.internal:11434
