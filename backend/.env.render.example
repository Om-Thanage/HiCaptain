# Render > existing backend service > Environment > Add from .env.
# Replace every REPLACE_* value before deploying. Render supplies PORT itself.
# Remove old SERVER_PORT / callback overrides; see the Render deployment section in README.md.
SPRING_PROFILES_ACTIVE=prod
MONGODB_URI=REPLACE_WITH_YOUR_MONGODB_CONNECTION_STRING
MONGODB_DATABASE=hicaptain
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SIGNING_KEY
BACKEND_URL=https://blueprint-dev.onrender.com
FRONTEND_URL=https://hicaptain.dev
CORS_ALLOWED_ORIGINS=https://hicaptain.dev,https://www.hicaptain.dev

# Stable encryption keys: preserve existing values if accounts are already connected.
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_GOOGLE_KEY
PROVIDER_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_PROVIDER_KEY

# Optional: one GitHub OAuth App for identity and project repository access.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo,read:user,user:email,admin:repo_hook
GITHUB_WEBHOOK_SECRET=

# Optional: Google sign-in and Workspace connection share one OAuth Web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for invitation delivery; use your SMTP provider's actual settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional: set the same secret in a separately deployed agent worker.
AGENT_WORKER_SECRET=
AUTH_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
